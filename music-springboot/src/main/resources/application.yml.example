# 复制本文件为 application.yml 后按自己的环境填写（真实文件已被 .gitignore 排除）
server:
  port: 8080
  servlet:
    context-path: /api
    session:
      timeout: 30m

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/musiconline?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8
    username: ${DB_USERNAME:root}
    password: ${DB_PASSWORD:}
    driver-class-name: com.mysql.cj.jdbc.Driver
  servlet:
    multipart:
      max-file-size: 5MB
      max-request-size: 10MB

mybatis-plus:
  configuration:
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
    map-underscore-to-camel-case: true
  global-config:
    db-config:
      logic-delete-field: deleteFlag
      logic-delete-value: 1
      logic-not-delete-value: 0
  type-enums-package: cn.cup.music.api.domain.enums

# 文件上传目录：按自己的系统改，例如 Windows 用 C:/musiconline/uploads/
file:
  upload-dir: ./uploads/
